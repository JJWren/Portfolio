@inject SiteConfig Site
@inject OwnerPhotoService Photo

@* The landing hero + about/skills, shared verbatim between Home and the
   admin theme editor's live preview so the preview can never drift from the
   real page. Everything gated on Site.Flavor == SiteFlavor.Bjj is additive:
   under the Default flavor this renders exactly the markup it always did
   (BR-1), pinned byte-for-byte by LandingSectionsRenderTests. *@

<section class="hero">
    <div class="container @(_photoUrl is not null ? "has-photo" : null)">
        <div class="ribbons" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="hero-text">
            @if (Site.Flavor == SiteFlavor.Bjj && Content.HeroEyebrow is { Length: > 0 } heroEyebrow)
            {
                <p class="eyebrow">@heroEyebrow</p>
            }
            <h1>@Content.HeroHeading</h1>
            @if (!string.IsNullOrEmpty(Content.Tagline))
            {
                <p class="tagline">@Content.Tagline</p>
            }
            <div class="actions">
                @if (Site.GitHubUrl is not null)
                {
                    <a class="btn btn-primary" href="@Site.GitHubUrl" rel="me noopener" target="_blank"><Icon Kind="github" />GitHub</a>
                }
                @if (Site.LinkedInUrl is not null)
                {
                    <a class="btn btn-ghost" href="@Site.LinkedInUrl" rel="me noopener" target="_blank"><Icon Kind="linkedin" />LinkedIn</a>
                }
                <a class="btn btn-ghost" href="/contact">Get in touch</a>
            </div>
        </div>
        @if (Site.Flavor == SiteFlavor.Bjj && _photoUrl is not null && _photoFlipUrl is not null)
        {
            <div class="photo-slot">
                <div class="photo-stack">
                    @* The desk tile deliberately carries no owner-photo class: .owner-photo adds
                       margin-top: 3rem, which would stack with .photo-stack's own margin inside
                       this absolutely positioned, overflow-hidden tile and clip the image; .photo-tile
                       and .photo-tile img supply the radius, sizing and object-fit instead (the
                       design source puts no class on the tile images either). The mat image is in
                       the viewport at opacity 0, so loading="lazy" alone would not defer it; it is
                       marked low priority so it never competes with the desk image (the LCP). *@
                    <div class="photo-tile desk"><img src="@_photoUrl" alt="@SeoRules.NormalizeAltText(Content.OwnerPhotoAlt)" fetchpriority="high" /></div>
                    <div class="photo-tile mat"><img src="@_photoFlipUrl" alt="@SeoRules.NormalizeAltText(Content.OwnerPhotoFlipAlt)" loading="lazy" fetchpriority="low" /></div>
                </div>
                <fieldset class="pill-switch photo-switch">
                    <legend class="visually-hidden">Show photo</legend>
                    <input type="radio" name="photo" id="ph-desk" checked /><label for="ph-desk">At the desk</label>
                    <input type="radio" name="photo" id="ph-mat" /><label for="ph-mat">On the mat</label>
                </fieldset>
            </div>
        }
        else if (_photoUrl is not null)
        {
            <img class="owner-photo" src="@_photoUrl" alt="@SeoRules.NormalizeAltText(Content.OwnerPhotoAlt)" fetchpriority="high" />
        }
        @if (Site.Flavor == SiteFlavor.Bjj && Content.GamePlan.Count == BjjRules.GamePlanNodeCount)
        {
            <GamePlan Nodes="@Content.GamePlan" />
        }
    </div>
</section>

@if (Site.Flavor == SiteFlavor.Bjj && Content.BeltCaption is { Length: > 0 } beltCaption)
{
    <div class="container">
        <RankBar Degrees="@Content.BeltDegrees" Caption="@beltCaption" />
    </div>
}

@if (Content.About is not null || Content.Skills.Count > 0)
{
    <section class="section">
        <div class="container">
            <p class="eyebrow">About</p>
            <div class="about-grid">
                @if (Content.About is not null)
                {
                    <div class="about-text">
                        @foreach (var paragraph in Content.About.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                }
                @if (Content.Skills.Count > 0)
                {
                    <ul class="skills">
                        @foreach (var skill in Content.Skills)
                        {
                            <li>@skill</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
}

@if (Site.Flavor == SiteFlavor.Bjj && Content.Principles.Count > 0)
{
    <section class="section" id="principles">
        <div class="container">
            <p class="eyebrow">Principles</p>
            <div class="principles">
                @foreach (var principle in Content.Principles)
                {
                    <div class="principle">
                        <h3>@principle.Maxim</h3>
                        @if (!string.IsNullOrEmpty(principle.Reading))
                        {
                            <p>@principle.Reading</p>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Site.Flavor == SiteFlavor.Bjj && Content.Eras.Count > 0)
{
    <section class="section">
        <div class="container">
            <p class="eyebrow">The road</p>
            <h2>Two ladders, one clock</h2>
            <Road Eras="@Content.Eras" Rungs="@Content.Rungs" />
        </div>
    </section>
}

@if (Site.Flavor == SiteFlavor.Bjj && Content.Now.Count > 0)
{
    <section class="section">
        <div class="container">
            <p class="eyebrow">Now</p>
            <dl class="now">
                @foreach (var item in Content.Now)
                {
                    <div>
                        <dt>@item.Label</dt>
                        <dd>@item.Value</dd>
                    </div>
                }
            </dl>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public EffectiveSiteContent Content { get; set; } = default!;

    private string? _photoUrl;
    private string? _photoFlipUrl;

    // Resolved once per render circuit, not per render: the file probe hits
    // the filesystem. Both slots are resolved even though the flip URL is
    // only ever used under the Bjj flavor, so OnInitialized stays one place
    // that touches the filesystem rather than splitting the probe across
    // flavors.
    protected override void OnInitialized()
    {
        _photoUrl = Photo.GetVersionedUrl();
        _photoFlipUrl = Photo.GetVersionedUrl(OwnerPhotoSlot.Flip);
    }
}
