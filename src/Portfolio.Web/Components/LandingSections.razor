@inject SiteConfig Site
@inject OwnerPhotoService Photo

@* The landing hero + about/skills, shared verbatim between Home and the
   admin theme editor's live preview so the preview can never drift from the
   real page. Everything gated on Site.Flavor == SiteFlavor.Bjj is additive:
   under the Default flavor this renders exactly the markup it always did
   (BR-1), pinned byte-for-byte by LandingSectionsRenderTests. *@

<section class="hero">
    <div class="container @(_photoUrl is not null ? "has-photo" : null)">
        <div class="ribbons" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="hero-text">
            @if (Site.Flavor == SiteFlavor.Bjj && Content.HeroEyebrow is { Length: > 0 } heroEyebrow)
            {
                <p class="eyebrow">@heroEyebrow</p>
            }
            <h1>@Content.HeroHeading</h1>
            @if (!string.IsNullOrEmpty(Content.Tagline))
            {
                <p class="tagline">@Content.Tagline</p>
            }
            <div class="actions">
                @if (Site.GitHubUrl is not null)
                {
                    <a class="btn btn-primary" href="@Site.GitHubUrl" rel="me noopener" target="_blank"><Icon Kind="github" />GitHub</a>
                }
                @if (Site.LinkedInUrl is not null)
                {
                    <a class="btn btn-ghost" href="@Site.LinkedInUrl" rel="me noopener" target="_blank"><Icon Kind="linkedin" />LinkedIn</a>
                }
                <a class="btn btn-ghost" href="/contact">Get in touch</a>
            </div>
        </div>
        @if (_photoUrl is not null)
        {
            <img class="owner-photo" src="@_photoUrl" alt="@SeoRules.NormalizeAltText(Content.OwnerPhotoAlt)" />
        }
        @if (Site.Flavor == SiteFlavor.Bjj && Content.GamePlan.Count == BjjRules.GamePlanNodeCount)
        {
            <GamePlan Nodes="@Content.GamePlan" />
        }
    </div>
</section>

@if (Site.Flavor == SiteFlavor.Bjj && Content.BeltCaption is { Length: > 0 } beltCaption)
{
    <div class="container">
        <RankBar Degrees="@Content.BeltDegrees" Caption="@beltCaption" />
    </div>
}

@if (Content.About is not null || Content.Skills.Count > 0)
{
    <section class="section">
        <div class="container">
            <p class="eyebrow">About</p>
            <div class="about-grid">
                @if (Content.About is not null)
                {
                    <div class="about-text">
                        @foreach (var paragraph in Content.About.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                }
                @if (Content.Skills.Count > 0)
                {
                    <ul class="skills">
                        @foreach (var skill in Content.Skills)
                        {
                            <li>@skill</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
}

@if (Site.Flavor == SiteFlavor.Bjj && Content.Principles.Count > 0)
{
    <section class="section" id="principles">
        <div class="container">
            <p class="eyebrow">Principles</p>
            <div class="principles">
                @foreach (var principle in Content.Principles)
                {
                    <div class="principle">
                        <h3>@principle.Maxim</h3>
                        @if (!string.IsNullOrEmpty(principle.Reading))
                        {
                            <p>@principle.Reading</p>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Site.Flavor == SiteFlavor.Bjj && Content.Eras.Count > 0)
{
    <section class="section">
        <div class="container">
            <p class="eyebrow">The road</p>
            <h2>Two ladders, one clock</h2>
            <Road Eras="@Content.Eras" Rungs="@Content.Rungs" />
        </div>
    </section>
}

@if (Site.Flavor == SiteFlavor.Bjj && Content.Now.Count > 0)
{
    <section class="section">
        <div class="container">
            <p class="eyebrow">Now</p>
            <dl class="now">
                @foreach (var item in Content.Now)
                {
                    <div>
                        <dt>@item.Label</dt>
                        <dd>@item.Value</dd>
                    </div>
                }
            </dl>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public EffectiveSiteContent Content { get; set; } = default!;

    private string? _photoUrl;

    // Resolved once per render circuit, not per render: the file probe hits
    // the filesystem.
    protected override void OnInitialized() => _photoUrl = Photo.GetVersionedUrl();
}
