@inject Portfolio.Web.Services.SiteConfig Site
@inject Portfolio.Web.Services.ThemeService ThemeStore
@inject NavigationManager Nav
@inject IConfiguration Config

<!DOCTYPE html>
@* data-flavor lets theme.js pick the BJJ wording for the theme toggle's
   tooltip. Null under the default flavor, so the attribute is omitted and
   the plain page's markup is unchanged. Unlike data-theme, which enhanced
   navigation strips and site.js re-applies through theme.js's __applyTheme,
   this attribute survives the merge because the server markup carries it. *@
<html lang="en" data-flavor="@Portfolio.Web.Services.SiteFlavorRules.HtmlDataFlavor(Site.Flavor)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@_theme.MetaThemeColor" />
    <meta property="og:site_name" content="@Site.SiteTitle" />
    <link rel="canonical" href="@_canonical" />
    <meta property="og:url" content="@_canonical" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="@Site.SiteTitle" href="/feed.xml" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/theme.js"]"></script>
    @* Preloads the Fraunces display font before first paint: every heading
       (h1 to h4) uses it, and on a photo-less hero the h1 is the LCP element
       (with a photo, the desk image is; see LandingSections). The href must be
       textually the same relative path app.css requests in its Fraunces
       @font-face, url('fonts/fraunces-latin.woff2'): the stylesheet is served
       from the wwwroot root, so its url() resolves to /fonts/..., and this tag
       resolves the same path against <base href="/">. A fingerprinted
       @Assets[...] URL would name a different resource than the one the
       stylesheet fetches, so the font would download twice instead of once.
       Public Sans and JetBrains Mono are body/mono faces, not render-critical,
       so only Fraunces is preloaded. *@
    <link rel="preload" href="fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @if (_theme.OverrideCss.Length > 0)
    {
        @* After app.css so the overridden tokens win the cascade by source
           order; MarkupString because Blazor would HTML-encode the selector's
           quotes. Only ThemeRules.BuildOverrideCss output lands here — every
           value is re-validated to #rrggbb at emission. *@
        <style>@((MarkupString)_theme.OverrideCss)</style>
    }
    <link rel="stylesheet" href="@Assets["Portfolio.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
    <link rel="manifest" href="site.webmanifest" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/prism.js"]" defer></script>
    <script src="@Assets["js/site.js"]" defer></script>
</body>

</html>

@code {
    // Safe for any render path; the shell is statically rendered per request
    // and no page streams, so OnInitializedAsync always completes before the
    // head is written — the override style block can never flash in late.
    private Portfolio.Web.Services.ThemeSnapshot _theme = Portfolio.Web.Services.ThemeRules.DefaultSnapshot;
    private string _canonical = string.Empty;

    protected override void OnInitialized()
    {
        // Canonical + og:url for every page: PUBLIC_BASE_URL (or the request
        // origin) plus the request path, query dropped — filter and pager
        // variants of a page all self-canonicalize to the bare listing.
        var uri = new Uri(Nav.Uri);
        _canonical = Portfolio.Web.Services.SeoRules.CanonicalUrl(
            Portfolio.Web.Services.SeoRules.CanonicalOrigin(
                Config["PUBLIC_BASE_URL"], uri.GetLeftPart(UriPartial.Authority)),
            uri.AbsolutePath);
    }

    protected override async Task OnInitializedAsync()
        => _theme = await ThemeStore.GetSnapshotAsync();
}
