@page "/blog/{Slug}"
@inject BlogService BlogPosts
@inject MarkdownService Markdown
@inject SiteConfig Site
@inject NavigationManager Nav
@inject IConfiguration Config

@if (_notFound)
{
    <PageTitle>Not found — @Site.SiteTitle</PageTitle>
    <NotFoundContent />
}
else if (_post is not null)
{
    <PageTitle>@_post.Title — @Site.SiteTitle</PageTitle>
    <SocialMeta Title="@_post.Title"
                Description="@_description"
                Type="article"
                ImagePath="@_post.HeaderImagePath"
                ImageAlt="@_post.HeaderImageAlt"
                PublishedAt="@_post.PublishedAt"
                ModifiedAt="@_post.UpdatedAt">
        @* Serializer-escaped in SeoRules — the MarkupString cannot break out
           of the script block. *@
        <script type="application/ld+json">@((MarkupString)_jsonLd)</script>
    </SocialMeta>

    <article>
        <header class="section page-head post-head">
            <div class="container">
                <p class="eyebrow">Blog</p>
                <h1>@_post.Title</h1>
                <p class="post-meta">
                    <time datetime="@_post.PublishedAt?.ToString("o")" data-local="date">
                        @_post.PublishedAt?.ToString("MMMM d, yyyy")
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>@Markdown.ReadingTimeMinutes(_post.BodyMarkdown) min read</span>
                </p>
                @if (_post.Tags.Count > 0)
                {
                    <ul class="tags">
                        @foreach (var tag in _post.Tags)
                        {
                            <li>@tag</li>
                        }
                    </ul>
                }
                <AuthorizeView Roles="Admin">
                    <a class="btn btn-ghost edit-post-link" href="/admin/posts/@_post.Id/edit">Edit post</a>
                </AuthorizeView>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(_post.HeaderImagePath))
        {
            <div class="container">
                @* Coalesce: Blazor omits null-valued attributes, and a
                   content image without alt is worse than an empty one. *@
                <img class="post-hero-image" src="@_post.HeaderImagePath"
                     alt="@(_post.HeaderImageAlt ?? string.Empty)" />
            </div>
        }

        <div class="container">
            <div class="prose">
                @((MarkupString)Markdown.ToHtml(_post.BodyMarkdown))
            </div>
        </div>

        <div class="container">
            <CommentSection PostId="_post.Id" PostSlug="@_post.Slug" />
        </div>
    </article>
}

@code {
    [Parameter]
    public required string Slug { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private Portfolio.Web.Data.BlogPost? _post;
    private bool _notFound;
    private string _description = string.Empty;
    private string _jsonLd = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _post = await BlogPosts.GetPublishedBySlugAsync(Slug);
        if (_post is null)
        {
            _notFound = true;
            if (HttpContext is not null)
            {
                HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            }
            return;
        }

        _description = SeoRules.TruncateDescription(_post.Summary);
        var origin = SeoRules.CanonicalOrigin(
            Config["PUBLIC_BASE_URL"], new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority));
        _jsonLd = SeoRules.BlogPostingJsonLd(
            _post.Title,
            _description,
            SeoRules.CanonicalUrl(origin, $"/blog/{_post.Slug}"),
            Site.OwnerName,
            _post.PublishedAt,
            _post.UpdatedAt,
            string.IsNullOrEmpty(_post.HeaderImagePath)
                ? null
                : SeoRules.AbsoluteUrl(origin, _post.HeaderImagePath));
    }
}
