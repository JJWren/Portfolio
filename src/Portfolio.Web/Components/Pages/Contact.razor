@page "/contact"
@using System.ComponentModel.DataAnnotations
@inject ContactService ContactStore
@inject ContactRateLimiter RateLimiter
@inject ContactFormTimestamp Timestamps
@inject MailDomainChecker MailCheck
@inject DisposableEmailDomains DisposableDomains
@inject AnalyticsService Analytics
@inject SiteConfig Site

<PageTitle>Contact — @Site.SiteTitle</PageTitle>
<SocialMeta Title="@($"Contact — {Site.SiteTitle}")"
            Description="@($"Get in touch with {Site.OwnerName} — contact form, email, and social links.")" />

<section class="section page-head">
    <div class="container">
        <p class="eyebrow">Contact</p>
        <h1>Say hello</h1>
    </div>
</section>

<section class="contact">
    <div class="container contact-grid">
        <div>
            @if (_sent)
            {
                <div class="sent-note">
                    <h2>Message sent</h2>
                    <p class="muted">Thanks for reaching out — I read everything and reply when I can.</p>
                    <a class="btn btn-ghost" href="/">Back to home</a>
                </div>
            }
            else
            {
                @if (_error is not null)
                {
                    <p class="alert" role="alert">@_error</p>
                }

                <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" FormName="contact">
                    <DataAnnotationsValidator />

                    <label class="field">
                        <span>Name</span>
                        <InputText @bind-Value="Model!.Name" />
                        <ValidationMessage For="() => Model!.Name" />
                    </label>

                    <label class="field">
                        <span>Email <span class="muted">for the reply</span></span>
                        <InputText @bind-Value="Model!.Email" type="email" />
                        <ValidationMessage For="() => Model!.Email" />
                    </label>

                    <label class="field">
                        <span>Subject</span>
                        <InputText @bind-Value="Model!.Subject" />
                        <ValidationMessage For="() => Model!.Subject" />
                    </label>

                    <label class="field">
                        <span>Message</span>
                        <InputTextArea @bind-Value="Model!.Message" rows="7" />
                        <ValidationMessage For="() => Model!.Message" />
                    </label>

                    @* Honeypot: invisible to people, irresistible to bots. *@
                    <div class="hp-field" aria-hidden="true">
                        <label>
                            Website
                            <InputText @bind-Value="Model!.Website" tabindex="-1" autocomplete="off" />
                        </label>
                    </div>

                    @* Protected render timestamp: sub-4s submits are bots. *@
                    <InputText @bind-Value="Model!.RenderedToken" type="hidden" autocomplete="off" tabindex="-1" />

                    <button class="btn btn-primary" type="submit">Send message</button>
                </EditForm>
            }
        </div>

        <aside class="contact-aside">
            <p class="eyebrow">Elsewhere</p>
            <ul class="contact-links">
                <li><a href="mailto:@Site.ContactEmail"><Icon Kind="email" />@Site.ContactEmail</a></li>
                @if (Site.ResumeFile is not null)
                {
                    <li><a href="/resume" data-enhance-nav="false"><Icon Kind="file" />Résumé</a></li>
                }
                @if (Site.ContactPhone is not null)
                {
                    <li><a href="tel:@Site.ContactPhone"><Icon Kind="phone" />@Site.ContactPhone</a></li>
                }
                @if (Site.LinkedInUrl is not null)
                {
                    <li><a href="@Site.LinkedInUrl" rel="me noopener" target="_blank"><Icon Kind="linkedin" />LinkedIn</a></li>
                }
                @if (Site.GitHubUrl is not null)
                {
                    <li><a href="@Site.GitHubUrl" rel="me noopener" target="_blank"><Icon Kind="github" />GitHub</a></li>
                }
            </ul>
        </aside>
    </div>
</section>

@code {
    [SupplyParameterFromForm]
    private ContactFormModel? Model { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new();
        // Issued on the GET render; POST re-renders keep the posted token so
        // elapsed time keeps growing across validation failures.
        if (string.IsNullOrEmpty(Model.RenderedToken))
        {
            Model.RenderedToken = Timestamps.Issue();
        }
    }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private bool _sent;
    private string? _error;

    private async Task HandleSubmitAsync()
    {
        // Bots that fill the honeypot get a quiet "success".
        if (!string.IsNullOrEmpty(Model!.Website))
        {
            _sent = true;
            return;
        }

        // Sub-4s submit: provably a bot, quiet "success". An undecipherable
        // token is NOT proof (DataProtection keys rotate across deploys), so
        // that only quarantines — a real message must never be lost to it.
        string? tokenFlag = null;
        if (Timestamps.TryGetElapsed(Model!.RenderedToken, out var elapsed))
        {
            if (elapsed < ContactSpamRules.MinSubmitTime)
            {
                _sent = true;
                return;
            }
        }
        else
        {
            tokenFlag = ContactSpamRules.InvalidTokenReason;
        }

        var ip = HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        if (!RateLimiter.Allow(ip))
        {
            _error = "That's a few messages in a row — give it a little while and try again.";
            return;
        }

        // Undeliverable domain gets a visible error — it catches typos, and a
        // typo'd address means the reply could never arrive anyway.
        if (await MailCheck.CheckAsync(Model!.Email) == MailDomainResult.NoMailServer)
        {
            _error = "That email domain doesn't appear to accept mail — double-check the address.";
            return;
        }

        var flag = ContactSpamRules.CombineReasons(
            tokenFlag,
            ContactSpamRules.SoftFlagReason(Model!.Email, Model!.Subject, Model!.Message, DisposableDomains));

        await ContactStore.SubmitAsync(Model!.Name, Model!.Email, Model!.Subject, Model!.Message, flag);
        if (HttpContext is not null)
        {
            await Analytics.TryRecordEventAsync(
                HttpContext, AnalyticsRules.ContactSubmitEvent, flag is null ? "ok" : "flagged");
        }

        _sent = true;
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Your name helps me say hello back.")]
        [StringLength(120)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "An email address is needed for the reply.")]
        [EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        [StringLength(254)]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "A subject makes the inbox easier to scan.")]
        [StringLength(200)]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "The message is the important part!")]
        [StringLength(4000)]
        public string Message { get; set; } = string.Empty;

        public string? Website { get; set; }

        public string? RenderedToken { get; set; }
    }
}

