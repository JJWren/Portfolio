@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject SiteConfig Site
@inject ReportService Reports
@inject ContactService Contacts
@inject AnalyticsService Analytics

<PageTitle>Admin — @Site.SiteTitle</PageTitle>

<section class="section">
    <div class="container">
        <p class="eyebrow">Admin</p>
        <h1>Dashboard</h1>
        <p class="muted">Manage the content on this site. More arrives as each area is built.</p>
        <div class="admin-cards">
            <a class="card card-link" href="/admin/posts">
                <h3>Blog posts</h3>
                <p class="muted">Write, edit, and publish posts.</p>
            </a>
            <a class="card card-link" href="/admin/projects">
                <h3>Projects</h3>
                <p class="muted">Curate the projects carousel.</p>
            </a>
            <a class="card card-link" href="/admin/comments">
                <h3>Comments</h3>
                <p class="muted">Moderate the conversation.</p>
            </a>
            <a class="card card-link" href="/admin/messages">
                <h3>
                    Messages
                    @if (_unreadMessages > 0)
                    {
                        <span class="badge badge-draft">@_unreadMessages unread</span>
                    }
                    @if (_flaggedMessages > 0)
                    {
                        <span class="badge badge-danger">@_flaggedMessages flagged</span>
                    }
                </h3>
                <p class="muted">Read contact-form messages.</p>
            </a>
            <a class="card card-link" href="/admin/stats">
                <h3>Stats</h3>
                <p class="muted">@_viewsLast7.ToString("N0") views in the last 7 days.</p>
            </a>
            <a class="card card-link" href="/admin/reports">
                <h3>
                    Reports
                    @if (_openReports > 0)
                    {
                        <span class="badge badge-draft">@_openReports open</span>
                    }
                </h3>
                <p class="muted">Review reported comments and users.</p>
            </a>
            <a class="card card-link" href="/admin/site">
                <h3>Site content</h3>
                <p class="muted">Override the landing-page hero, tagline, about, and skills.</p>
            </a>
            <a class="card card-link" href="/admin/theme">
                <h3>Theme</h3>
                <p class="muted">Override the site's colors for dark and light mode.</p>
            </a>
        </div>
    </div>
</section>

@code {
    private int _openReports;
    private int _unreadMessages;
    private int _flaggedMessages;
    private int _viewsLast7;

    protected override async Task OnInitializedAsync()
    {
        var counts = await Task.WhenAll(
            Reports.OpenCountAsync(), Contacts.UnreadCountAsync(),
            Contacts.FlaggedCountAsync(), Analytics.ViewsInLastDaysAsync(7));
        _openReports = counts[0];
        _unreadMessages = counts[1];
        _flaggedMessages = counts[2];
        _viewsLast7 = counts[3];
    }
}
