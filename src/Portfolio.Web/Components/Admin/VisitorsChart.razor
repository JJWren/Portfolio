@using System.Globalization
@using System.Net

@* No-script chart: this SVG is plain markup computed from Points on every
   render — a period change re-renders the whole thing through the existing
   InteractiveServer circuit, nothing here calls into JS. Reading a value
   works two ways without a script: a CSS-only hover/focus rule in app.css
   reveals each day's tooltip (.day .tip), and the <details> table below the
   chart carries every value in plain text as the assistive-tech reading
   (FR-V9). *@

<section class="card visitors-chart">
    <h2 id="visitors-chart-title">Daily visitors</h2>
    <p class="muted">one point per UTC day</p>
    @if (Points.Count < VisitorsChartRules.MinPoints)
    {
        <p class="muted">Not enough data to chart yet.</p>
    }
    else
    {
        <svg viewBox="0 0 720 240" role="img" aria-labelledby="visitors-chart-title" class="visitors-svg">
            <g class="grid">
                @foreach (var tick in Ticks)
                {
                    var y = VisitorsChartRules.Y(tick, NiceMaxValue);
                    <line x1="@Coord(Layout.Left)" y1="@Coord(y)" x2="@Coord(Layout.Width - Layout.Right)" y2="@Coord(y)" />
                    @SvgText("axis", Layout.Left - 6, y + 3.5, "end", tick.ToString("N0", CultureInfo.InvariantCulture))
                }
            </g>
            <g class="axis-x">
                @for (var i = 0; i < LabelIndexesValue.Count; i++)
                {
                    var index = LabelIndexesValue[i];
                    var anchor = i == 0 ? "start" : i == LabelIndexesValue.Count - 1 ? "end" : "middle";
                    @SvgText(null, VisitorsChartRules.X(index, Points.Count), Layout.Height - Layout.Bottom + 16, anchor, VisitorsChartRules.FormatDay(Points[index].Day))
                }
            </g>
            <path class="line" d="@LinePathValue" />
            @if (LastIsToday)
            {
                <path class="today" d="@TodayPathValue" />
                <circle class="marker" cx="@Coord(LastX)" cy="@Coord(LastY)" r="4" />
            }
            <g class="days">
                @for (var i = 0; i < Points.Count; i++)
                {
                    var point = Points[i];
                    var x = VisitorsChartRules.X(i, Points.Count);
                    var y = VisitorsChartRules.Y(point.Visitors, NiceMaxValue);
                    var half = ColumnWidth / 2.0;
                    var anchor = VisitorsChartRules.TooltipAnchor(i, Points.Count);
                    var boxX = TipBoxX(x, anchor);
                    var boxY = TipBoxY(y);
                    <g class="day" tabindex="0" aria-label="@AriaLabel(point)">
                        <rect class="hit" x="@Coord(x - half)" y="@Coord(Layout.Top)" width="@Coord(ColumnWidth)" height="@Coord(Layout.PlotHeight)" />
                        <g class="tip">
                            <line class="crosshair" x1="@Coord(x)" y1="@Coord(Layout.Top)" x2="@Coord(x)" y2="@Coord(Layout.Height - Layout.Bottom)" />
                            <circle class="marker" cx="@Coord(x)" cy="@Coord(y)" r="4" />
                            <rect class="tip-box" x="@Coord(boxX)" y="@Coord(boxY)" width="@Coord(TipBoxWidth)" height="@Coord(TipBoxHeight)" />
                            @SvgText("tip-text", boxX + TipTextPadding, boxY + (TipBoxHeight / 2.0) + 4, "start", TipText(point))
                        </g>
                    </g>
                }
            </g>
        </svg>
        <details class="visitors-data">
            <summary>Data table</summary>
            <table>
                <thead>
                    <tr><th>Day</th><th>Visitors</th></tr>
                </thead>
                <tbody>
                    @foreach (var point in Points)
                    {
                        <tr>
                            <td>@point.Day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)@(point.IsToday ? " today so far" : "")</td>
                            <td>@point.Visitors.ToString("N0", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </details>
    }
</section>

@code {
    private const double TipBoxWidth = 210;
    private const double TipBoxHeight = 28;
    private const double TipGap = 8;
    private const double TipTextPadding = 8;
    private const double ViewboxMargin = 2;

    private static readonly VisitorsChartRules.ChartLayout Layout = VisitorsChartRules.Layout;

    [Parameter, EditorRequired]
    public IReadOnlyList<DailyVisitorPoint> Points { get; set; } = [];

    private IReadOnlyList<int> Values => [.. Points.Select(p => p.Visitors)];

    private int NiceMaxValue => VisitorsChartRules.NiceMax(Points.Count == 0 ? 0 : Points.Max(p => p.Visitors));

    private IReadOnlyList<int> Ticks => VisitorsChartRules.Ticks(NiceMaxValue);

    private IReadOnlyList<int> LabelIndexesValue => VisitorsChartRules.LabelIndexes(Points.Count);

    private bool LastIsToday => Points.Count > 0 && Points[^1].IsToday;

    private string LinePathValue => VisitorsChartRules.LinePath(Values, NiceMaxValue, LastIsToday);

    private string TodayPathValue => VisitorsChartRules.TodayPath(Values, NiceMaxValue);

    private double LastX => VisitorsChartRules.X(Points.Count - 1, Points.Count);

    private double LastY => VisitorsChartRules.Y(Points[^1].Visitors, NiceMaxValue);

    /// <summary>The hit column's width: the gap between neighboring points,
    /// never under 6 units (FR-V8) even when a long period packs points
    /// closer together than that.</summary>
    private double ColumnWidth => Points.Count > 1
        ? Math.Max(6.0, Layout.PlotWidth / (double)(Points.Count - 1))
        : Layout.PlotWidth;

    private static string Coord(double value) => VisitorsChartRules.FormatCoordinate(value);

    private static string Coord(int value) => value.ToString(CultureInfo.InvariantCulture);

    /// <summary>
    /// Builds one SVG &lt;text&gt; element. Razor's own <c>&lt;text&gt;</c>
    /// tag is a reserved markup-transition construct and can never carry
    /// attributes (RZ1023), so a literal <c>&lt;text x="..." y="..."&gt;</c>
    /// in this file's markup won't compile — every text label is built here
    /// instead and returned as a <see cref="MarkupString"/>. The only
    /// interpolated piece is <paramref name="content"/> (a formatted number
    /// or <see cref="VisitorsChartRules.FormatDay"/>/<see cref="TipText"/>
    /// output — never admin-editable copy), and it is still HTML-encoded
    /// before being embedded, so this stays safe even if that ever changes.
    /// </summary>
    private static MarkupString SvgText(string? cssClass, double x, double y, string textAnchor, string content)
    {
        var classAttribute = cssClass is null ? string.Empty : $" class=\"{cssClass}\"";
        var encodedContent = WebUtility.HtmlEncode(content);
        return new MarkupString(
            $"<text{classAttribute} x=\"{Coord(x)}\" y=\"{Coord(y)}\" text-anchor=\"{textAnchor}\">{encodedContent}</text>");
    }

    /// <summary>The tooltip box's left edge: grown out from the crosshair on
    /// the side <see cref="VisitorsChartRules.TooltipAnchor"/> gives, then
    /// clamped so the box never leaves the viewBox even for a day right at
    /// the chart's edge.</summary>
    private double TipBoxX(double pointX, string anchor)
    {
        var raw = anchor == "start" ? pointX + TipGap : pointX - TipGap - TipBoxWidth;
        return Math.Clamp(raw, ViewboxMargin, Layout.Width - TipBoxWidth - ViewboxMargin);
    }

    /// <summary>The tooltip box's top edge: centred on the point, then
    /// clamped to stay inside the plot band (never over the axis labels).</summary>
    private double TipBoxY(double pointY)
        => Math.Clamp(
            pointY - (TipBoxHeight / 2.0),
            Layout.Top,
            Layout.Height - Layout.Bottom - TipBoxHeight);

    private static string AriaLabel(DailyVisitorPoint point)
        => point.IsToday
            ? $"{VisitorsChartRules.FormatDay(point.Day)}, today so far: {point.Visitors.ToString("N0", CultureInfo.InvariantCulture)} visitors"
            : $"{VisitorsChartRules.FormatDay(point.Day)}: {point.Visitors.ToString("N0", CultureInfo.InvariantCulture)} visitors";

    private static string TipText(DailyVisitorPoint point)
        => point.IsToday
            ? $"{VisitorsChartRules.FormatDay(point.Day)} · today so far · {point.Visitors.ToString("N0", CultureInfo.InvariantCulture)}"
            : $"{VisitorsChartRules.FormatDay(point.Day)} · {point.Visitors.ToString("N0", CultureInfo.InvariantCulture)}";
}
