@page "/admin/site"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject SiteContentService ContentStore
@inject SiteConfig Site
@inject OwnerPhotoService Photo

<PageTitle>Site content — Admin — @Site.SiteTitle</PageTitle>

<section class="section">
    <div class="container narrow-form">
        <p class="eyebrow">Admin</p>
        <div class="admin-head">
            <h1>Site content</h1>
            <a class="btn btn-ghost" href="/admin">Back to dashboard</a>
        </div>

        @if (_loading)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            <p class="muted">
                Overrides replace the matching .env value on the landing page.
                Leave a field blank to keep using the .env value.
            </p>

            @if (_error is not null)
            {
                <p class="alert" role="alert">@_error</p>
            }
            @if (_saved)
            {
                <p class="saved-note" role="status">Saved — the landing page now shows these values.</p>
            }

            <label class="field">
                <span>Hero heading <span class="muted">the landing-page H1</span></span>
                <input type="text" maxlength="@SiteContentRules.HeroHeadingMaxLength"
                       @bind="_heroHeading" @bind:after="MarkDirty" placeholder="@Site.OwnerName" />
            </label>

            <label class="field">
                <span>Tagline <span class="muted">also the meta description</span></span>
                <input type="text" maxlength="@SiteContentRules.TaglineMaxLength"
                       @bind="_tagline" @bind:after="MarkDirty" placeholder="@Site.Tagline" />
            </label>

            <label class="field">
                <span>About <span class="muted">each line becomes a paragraph</span></span>
                <textarea rows="8" maxlength="@SiteContentRules.AboutMaxLength"
                          @bind="_about" @bind:after="MarkDirty" placeholder="@Site.About"></textarea>
            </label>

            <label class="field">
                <span>Skills <span class="muted">one per line</span></span>
                <textarea rows="6" @bind="_skillsText" @bind:after="MarkDirty"
                          placeholder="@SiteContentRules.SkillsText(Site.Skills)"></textarea>
            </label>

            @if (Site.Flavor == SiteFlavor.Bjj)
            {
                <p class="eyebrow">Mat</p>

                <label class="field">
                    <span>Hero eyebrow <span class="muted">line above the hero heading</span></span>
                    <input type="text" maxlength="@SiteContentRules.HeroEyebrowMaxLength"
                           @bind="_heroEyebrow" @bind:after="MarkDirty" placeholder="@Site.HeroEyebrow" />
                </label>

                <label class="field">
                    <span>Game plan <span class="muted">one node per line: term | reading | how, exactly four lines</span></span>
                    <textarea rows="6" @bind="_gamePlanText" @bind:after="MarkDirty"
                              placeholder="@SiteContentRules.LinesText(Site.GamePlanLines)"></textarea>
                </label>

                <label class="field">
                    <span>Belt caption <span class="muted">shown under the rank bar</span></span>
                    <input type="text" maxlength="@SiteContentRules.BeltCaptionMaxLength"
                           @bind="_beltCaption" @bind:after="MarkDirty" placeholder="@Site.BeltCaption" />
                </label>

                <label class="field">
                    <span>Belt degrees <span class="muted">stripes on the rank bar, 0 to 6</span></span>
                    <input type="number" min="0" max="@BjjRules.MaxDegrees"
                           @bind="_beltDegreesText" @bind:after="MarkDirty"
                           placeholder="@(Site.BeltDegrees?.ToString())" />
                </label>

                <label class="field">
                    <span>Principles <span class="muted">one per line: maxim | reading</span></span>
                    <textarea rows="6" @bind="_principlesText" @bind:after="MarkDirty"
                              placeholder="@SiteContentRules.LinesText(Site.PrincipleLines)"></textarea>
                </label>

                <label class="field">
                    <span>Eras <span class="muted">one per line: date | belt | stripes | gym | location | role, date as YYYY-MM-DD, belt white, blue, purple, brown or black</span></span>
                    <textarea rows="8" @bind="_erasText" @bind:after="MarkDirty"
                              placeholder="@SiteContentRules.LinesText(Site.EraLines)"></textarea>
                </label>

                <label class="field">
                    <span>Now <span class="muted">one per line: label | value</span></span>
                    <textarea rows="6" @bind="_nowText" @bind:after="MarkDirty"
                              placeholder="@SiteContentRules.LinesText(Site.NowLines)"></textarea>
                </label>
            }

            <div class="field">
                <span>Owner photo <span class="muted">shown on the landing hero</span></span>
                @if (!Photo.IsConfigured)
                {
                    <p class="muted">
                        Set OWNER_PHOTO_FILE in .env (and mount its folder read-write)
                        to enable the landing-page photo.
                    </p>
                }
                else
                {
                    @if (_photoUrl is not null)
                    {
                        <img class="owner-photo-preview" src="@_photoUrl" alt="Current owner photo" />
                    }
                    else
                    {
                        <p class="muted">
                            No photo yet — upload one here, or copy an image file onto
                            the OWNER_PHOTO_FILE path.
                        </p>
                    }
                    <div class="editor-actions">
                        <label class="btn btn-ghost photo-upload">
                            @(_photoBusy ? "Uploading…" : "Upload photo")
                            <InputFile OnChange="UploadPhotoAsync" accept="image/png,image/jpeg,image/webp,image/gif" disabled="@_photoBusy" />
                        </label>
                        @if (_photoUrl is not null)
                        {
                            <button class="btn btn-ghost" @onclick="RemovePhoto" disabled="@_photoBusy">Remove</button>
                        }
                    </div>
                }
            </div>

            @if (Photo.IsConfigured)
            {
                <label class="field">
                    <span>Photo alt text <span class="muted">describes the photo for screen readers</span></span>
                    <input type="text" maxlength="@SiteContentRules.OwnerPhotoAltMaxLength"
                           @bind="_ownerPhotoAlt" @bind:after="MarkDirty"
                           placeholder="@(Site.OwnerPhotoAlt ?? $"Portrait of {Site.OwnerName}")" />
                </label>
            }

            <div class="editor-actions">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">
                    @(_busy ? "Saving…" : "Save")
                </button>
            </div>
        }
    </div>
</section>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _saved;
    private string? _error;

    private string _heroHeading = string.Empty;
    private string _tagline = string.Empty;
    private string _about = string.Empty;
    private string _skillsText = string.Empty;
    private string _ownerPhotoAlt = string.Empty;
    private string? _photoUrl;
    private bool _photoBusy;

    // BJJ landing flavor (Unit 10); only shown/edited under Site.Flavor == SiteFlavor.Bjj.
    private string _heroEyebrow = string.Empty;
    private string _gamePlanText = string.Empty;
    private string _beltCaption = string.Empty;
    private string _beltDegreesText = string.Empty;
    private string _principlesText = string.Empty;
    private string _erasText = string.Empty;
    private string _nowText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _photoUrl = Photo.GetVersionedUrl();
        try
        {
            SeedForm(await ContentStore.GetOverridesAsync());
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = "Couldn't load the saved overrides — refresh to try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Edits after a save mean the note no longer reflects the stored state.</summary>
    private void MarkDirty() => _saved = false;

    private void SeedForm(Portfolio.Web.Data.SiteContent? overrides)
    {
        _heroHeading = overrides?.HeroHeading ?? string.Empty;
        _tagline = overrides?.Tagline ?? string.Empty;
        _about = overrides?.About ?? string.Empty;
        _skillsText = SiteContentRules.SkillsText(overrides?.Skills);
        _ownerPhotoAlt = overrides?.OwnerPhotoAlt ?? string.Empty;
        _heroEyebrow = overrides?.HeroEyebrow ?? string.Empty;
        _gamePlanText = SiteContentRules.LinesText(overrides?.GamePlan);
        _beltCaption = overrides?.BeltCaption ?? string.Empty;
        _beltDegreesText = overrides?.BeltDegrees?.ToString() ?? string.Empty;
        _principlesText = SiteContentRules.LinesText(overrides?.Principles);
        _erasText = SiteContentRules.LinesText(overrides?.Eras);
        _nowText = SiteContentRules.LinesText(overrides?.Now);
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        if (_photoBusy)
        {
            return;
        }

        _photoBusy = true;
        _error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(OwnerPhotoService.MaxBytes);
            await Photo.SaveAsync(stream);
            _photoUrl = Photo.GetVersionedUrl();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or SixLabors.ImageSharp.ImageFormatException)
        {
            _error = ex is SixLabors.ImageSharp.ImageFormatException
                ? "That file isn't a readable image — use a PNG, JPEG, WebP, or GIF."
                : ex.Message;
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private void RemovePhoto()
    {
        Photo.Delete();
        _photoUrl = Photo.GetVersionedUrl();
    }

    private async Task SaveAsync()
    {
        if (_busy)
        {
            return; // Queued double-clicks must not overlap saves.
        }

        _saved = false;
        var draft = new SiteContentDraft(
            HeroHeading: _heroHeading,
            Tagline: _tagline,
            About: _about,
            SkillsText: _skillsText,
            OwnerPhotoAlt: _ownerPhotoAlt,
            HeroEyebrow: _heroEyebrow,
            GamePlanText: _gamePlanText,
            BeltCaption: _beltCaption,
            BeltDegreesText: _beltDegreesText,
            PrinciplesText: _principlesText,
            ErasText: _erasText,
            NowText: _nowText);
        _error = SiteContentRules.Validate(draft, Site);
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            await ContentStore.SaveAsync(draft);
            // Re-seed so the form shows what was actually stored (trimmed, normalized).
            SeedForm(await ContentStore.GetOverridesAsync());
            _saved = true;
        }
        catch (DbUpdateException)
        {
            // The service already retries the concurrent first-save race, so
            // whatever lands here is unexpected — surface it for a manual retry.
            _error = "Saving failed — the database rejected the change. Try again in a moment.";
        }
        finally
        {
            _busy = false;
        }
    }
}
