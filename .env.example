# -- Site identity ------------------------------------------------
# These personalize the site; no personal details live in code.
SITE_OWNER_NAME=Jane Developer
SITE_TITLE=Jane Developer - Portfolio
SITE_TAGLINE=Full-stack developer building useful things.
# Optional dedicated description for search results and link previews.
# Falls back to SITE_TAGLINE when blank.
SITE_META_DESCRIPTION=
# Optional about-section text; use \n between paragraphs. Hidden when blank.
SITE_ABOUT=I build web apps and developer tooling.\nOff hours I tinker with my home lab.
# Optional comma-separated skill chips shown next to the about text.
SITE_SKILLS=C#,ASP.NET Core,PostgreSQL,Docker,TypeScript

# -- Contact & social links ---------------------------------------
CONTACT_EMAIL=you@example.com
# Optional; leave blank to hide from the site.
CONTACT_PHONE=
LINKEDIN_URL=https://www.linkedin.com/in/your-handle/
# Drives the "see all my work on GitHub" link on the Projects page.
GITHUB_URL=https://github.com/your-handle
# Optional footer sponsor link (Buy Me a Coffee, GitHub Sponsors, Ko-fi, ...).
# Leave the URL blank to hide the link entirely.
SPONSOR_URL=
SPONSOR_TEXT=Buy me a coffee

# -- Admin access -------------------------------------------------
# Comma-separated. Users whose OAuth email matches get the Admin role.
ADMIN_EMAILS=you@example.com

# -- Database (compose wires the connection string automatically) -
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# -- Web ----------------------------------------------------------
WEB_PORT=8080
# Host interface the published port binds to. Blank (default) publishes on
# every interface (0.0.0.0); see "Running behind a reverse proxy" in the
# README for when to narrow this.
WEB_BIND=
# Comma-separated list of IP addresses and/or CIDR networks (for example
# 203.0.113.0/24) whose X-Forwarded-For header is trusted for the connecting
# address that rate limits and visitor analytics use. Blank trusts every
# peer's X-Forwarded-For, which is fine with no reverse proxy in front but
# lets a direct client forge its address once one is; set it to your
# proxy's own address or network once you add one. A value that's set but
# has no address or network the app can parse stops startup instead of
# silently trusting every peer. See "Running behind a reverse proxy".
TRUSTED_PROXIES=
# Content-Security-Policy mode: enforce (default; also blank or any other
# value), report-only (sends Content-Security-Policy-Report-Only instead, so
# you can check the browser console before switching to enforce), or off
# (sends neither). The other security headers (nosniff, Referrer-Policy,
# X-Frame-Options, Permissions-Policy, Cross-Origin-Opener-Policy) are
# always sent regardless of this setting.
SECURITY_CSP_MODE=

# -- SMTP (contact form email delivery) ---------------------------
# Messages are always stored in the database; SMTP is how you get
# notified. Leave HOST blank to disable email sending.
SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USER=you@example.com
SMTP__PASSWORD=app-password-here
SMTP__FROM=you@example.com

# -- OAuth sign-in providers --------------------------------------
# Only providers with BOTH client id and secret set are enabled and
# shown on the sign-in page. Callback URLs to register:
#   GitHub:  https://your-domain/signin-github
#   Google:  https://your-domain/signin-google
#   Discord: https://your-domain/signin-discord
OAUTH__GITHUB__CLIENTID=
OAUTH__GITHUB__CLIENTSECRET=
OAUTH__GOOGLE__CLIENTID=
OAUTH__GOOGLE__CLIENTSECRET=
OAUTH__DISCORD__CLIENTID=
OAUTH__DISCORD__CLIENTSECRET=

# -- Optional features --------------------------------------------
# Populate sample posts/projects on first run so the site isn't empty.
SEED_DEMO_DATA=false
# Canonical site origin used in the RSS feed, sitemap, and robots.txt.
# Falls back to the request host when blank.
PUBLIC_BASE_URL=
# Path (inside the container) to a résumé PDF served at /resume with
# download counting. Mount its folder read-write so the admin site-content
# page can replace the file. Blank = no résumé link anywhere.
RESUME_FILE=
# Path (inside the container) to the owner photo shown on the landing hero
# and served at /owner-photo. Mount its folder read-write so the admin
# site-content page can replace the file. Blank = photo-less hero.
OWNER_PHOTO_FILE=
# Optional alt text for the photo; defaults to "Portrait of {SITE_OWNER_NAME}"
# and can be overridden from the admin site-content page.
OWNER_PHOTO_ALT=
# Path (inside the container) to a second portrait shown as a switchable
# "mat" photo under the primary one (BJJ landing flavor only; mount its
# folder read-write like OWNER_PHOTO_FILE). Blank = the hero shows only the
# primary photo.
OWNER_PHOTO_FLIP_FILE=
# Optional alt text for the second photo; defaults to
# "Portrait of {SITE_OWNER_NAME}" and can be overridden from the admin
# site-content page. Example: Portrait of the site owner on the mat
OWNER_PHOTO_FLIP_ALT=

# -- BJJ landing flavor (optional) ---------------------------------
# Opt-in belt-themed landing page. "bjj" (case-insensitive) enables the
# hero eyebrow, game-plan chart, rank bar and Principles section below;
# blank or any other value renders the plain landing page with none of it.
SITE_FLAVOR=
# Line shown above the hero heading (often the owner's name and title).
SITE_HERO_EYEBROW=
# Game-plan chart nodes: one per line, "term | reading | how" (how is
# optional). Exactly four lines or the chart stays hidden. Use the literal
# \n between lines the way SITE_ABOUT does — .env files can't hold real
# newlines. Example:
# SITE_GAME_PLAN=Warm-up | Loosen up | Light movement first.\nDrill | Repeat the motion | \nRoll | Test it live | \nRest | Recover |
SITE_GAME_PLAN=
# Caption shown under the rank bar; the bar is hidden when this is blank.
SITE_BELT_CAPTION=
# The belt the rank bar draws: white, blue, purple, brown or black; blank draws a black belt.
SITE_CURRENT_BELT=
# Degree stripes drawn on the rank bar, 0 to 6 (degrees on a black belt).
SITE_BELT_DEGREES=
# One to six "maxim | reading" lines (reading is optional), same \n joining
# as SITE_GAME_PLAN. Example:
# SITE_PRINCIPLES=Ship small, ship often. | Small changes are easy to review and easy to revert.\nWrite it down. | Future you does not remember today's context.
SITE_PRINCIPLES=
# The road: one to twelve "date | belt | stripes | gym | location | role"
# lines, in the order entered (nothing re-sorts). date is YYYY-MM-DD; belt is
# white, blue, purple, brown or black; stripes is 0 to 6 (blank = 0); gym,
# location and role may be blank. Same \n joining as SITE_GAME_PLAN. Example:
# SITE_ERAS=2019-03-01 | blue | 2 | Example Gym | Springfield, IL | Junior developer.\n2021-07-15 | purple | 0 | Example Gym | Springfield, IL | Senior developer.
SITE_ERAS=
# One to eight "label | value" lines (value is optional), same \n joining as
# SITE_GAME_PLAN. Example:
# SITE_NOW=Building | A side project\nReading | A long novel
SITE_NOW=
